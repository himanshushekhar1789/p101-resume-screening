# Application Settings
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-insecure-default-key

# Database Connection (Default SQLite for MVP development, PostgreSQL for production)
DATABASE_URL=sqlite:///./resume_screening.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_screening_db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# LLM Configuration (Provider Abstraction)
# Supported: gemini, openai, anthropic, mock (for offline/dry-run test execution)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2

# Embedding Model Configuration & Semantic Matching (Phase 7)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SEMANTIC_MATCHING_ENABLED=True
SEMANTIC_HIGH_THRESHOLD=0.75
SEMANTIC_MEDIUM_THRESHOLD=0.55

# Default Configurable Fusion Scoring Weights (Sum to 1.0, Phase 8)
RULE_FIT_WEIGHT=0.30
SEMANTIC_FIT_WEIGHT=0.40
EXPERIENCE_FIT_WEIGHT=0.20
LLM_FIT_WEIGHT=0.10
NOT_EVALUABLE_POLICY=exclude

# Legacy / alternative alias support
WEIGHT_RULE_FIT=0.30
WEIGHT_SEMANTIC_FIT=0.40
WEIGHT_EXPERIENCE_FIT=0.20
WEIGHT_LLM_FIT=0.10

# Privacy & Masking Mode Default
DEFAULT_MASKED_MODE=False
